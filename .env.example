# --- ACE-Step 1.5 engine (REST API started with `uv run acestep-api --host 0.0.0.0`) ---
# With docker compose, the backend runs in a container, so "localhost" would point at the
# container itself. host.docker.internal reaches the host machine where the engine runs.
# Change to http://localhost:8001 only when running the backend directly (no Docker).
ACESTEP_API_URL=http://host.docker.internal:8001
ACESTEP_MODEL=acestep-v15-turbo
# flac (default) works everywhere; mp3 requires ffmpeg installed on the engine host
ACESTEP_AUDIO_FORMAT=flac

# --- OmniRoute gateway (OpenAI-compatible; routes to free/cheap providers first) ---
# Run locally: docker run -p 4000:4000 diegosouzapw/omniroute
OMNIROUTE_BASE_URL=http://localhost:4000/v1
OMNIROUTE_API_KEY=sk-omniroute-local
# Login password for the OmniRoute dashboard at http://localhost:4000
OMNIROUTE_ADMIN_PASSWORD=crescendo-admin
# Model id in OmniRoute's alias/model format. Enable a provider in the dashboard
# (e.g. Pollinations, free, no key) and pick a model from GET /v1/models.
OMNIROUTE_MODEL=pollinations/openai

# --- Crescendo backend ---
DATABASE_URL=sqlite:///./crescendo.db
CORS_ORIGINS=http://localhost:5173
POLL_INTERVAL_SECONDS=3

# --- Frontend ---
VITE_API_URL=http://localhost:8000
